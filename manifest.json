{
  "manifest_version": 3,
  "name": "Pinned Sidebar",
  "version": "1.1.0",
  "description": "Luôn hiển thị thanh sidebar với các icon website đã ghim, mở xem ngay trong sidebar kiểu mobile. Tái tạo tính năng sidebar cũ của Edge.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "contextMenus",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Mở/đóng Pinned Sidebar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Mở/đóng Pinned Sidebar"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_unlock",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
