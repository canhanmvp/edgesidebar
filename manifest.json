{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "4.3.0",
  "minimum_chrome_version": "120",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "tabGroups"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "optional_permissions": ["bookmarks"],
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "omnibox": {
    "keyword": "p"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["i18n-en.js", "i18n.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "__MSG_cmdOpen__"
    },
    "open-sidebar": {
      "suggested_key": {
        "default": "Ctrl+M"
      },
      "description": "__MSG_cmdOpenFast__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
